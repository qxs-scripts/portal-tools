do
	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Vertical
	layout.Padding = UDim.new(0, 10)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = bar
end

local function makeButton(name, label, color, order, tip, callback)
	local btn = Instance.new("TextButton")
	btn.Name = name
	btn.LayoutOrder = order
	btn.Size = UDim2.fromOffset(BUTTON_SIZE, BUTTON_SIZE)
	btn.BackgroundColor3 = color
	btn.AutoButtonColor = false
	btn.Text = label
	btn.TextColor3 = Color3.new(1, 1, 1)
	btn.TextStrokeTransparency = 0.75
	btn.Font = Enum.Font.GothamBold
	btn.TextSize = 12
	btn.Parent = bar

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 12)
	corner.Parent = btn

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.new(1, 1, 1)
	stroke.Transparency = 0.55
	stroke.Thickness = 1.5
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = btn

	local scale = Instance.new("UIScale")
	scale.Parent = btn

	local tipLabel = Instance.new("TextLabel")
	tipLabel.AnchorPoint = Vector2.new(0, 0.5)
	tipLabel.Position = UDim2.new(1, 10, 0.5, 0)
	tipLabel.AutomaticSize = Enum.AutomaticSize.X
	tipLabel.Size = UDim2.fromOffset(0, 26)
	tipLabel.BackgroundColor3 = Color3.fromRGB(15, 15, 18)
	tipLabel.BackgroundTransparency = 0.15
	tipLabel.Text = tip
	tipLabel.TextColor3 = Color3.new(1, 1, 1)
	tipLabel.Font = Enum.Font.GothamMedium
	tipLabel.TextSize = 13
	tipLabel.Visible = false
	tipLabel.Parent = btn
	do
		local pad = Instance.new("UIPadding")
		pad.PaddingLeft = UDim.new(0, 10)
		pad.PaddingRight = UDim.new(0, 10)
		pad.Parent = tipLabel
		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(0, 8)
		c.Parent = tipLabel
	end

	local function tweenScale(v)
		TweenService:Create(scale, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Scale = v }):Play()
	end
	btn.MouseEnter:Connect(function()
		tweenScale(1.1)
		tipLabel.Visible = true
	end)
	btn.MouseLeave:Connect(function()
		tweenScale(1)
		tipLabel.Visible = false
	end)
	btn.MouseButton1Down:Connect(function()
		tweenScale(0.92)
	end)
	btn.MouseButton1Up:Connect(function()
		tweenScale(1.1)
	end)
	btn.Activated:Connect(callback)

	return btn, stroke
end

