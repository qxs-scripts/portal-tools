local panelOpen = false
local setPanel -- forward declaration

local thumbCache = {}

local function makeEntry(plr, order)
	local entry = Instance.new("TextButton")
	entry.Name = plr.Name
	entry.LayoutOrder = order
	entry.Size = UDim2.new(1, -6, 0, 44)
	entry.BackgroundColor3 = Color3.fromRGB(22, 52, 32)
	entry.AutoButtonColor = false
	entry.Text = ""
	entry.Parent = list

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 10)
	corner.Parent = entry

	local stroke = Instance.new("UIStroke")
	stroke.Color = CONFIG.GREEN
	stroke.Transparency = 0.7
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = entry

	local avatar = Instance.new("ImageLabel")
	avatar.BackgroundColor3 = Color3.fromRGB(10, 30, 18)
	avatar.Position = UDim2.fromOffset(8, 6)
	avatar.Size = UDim2.fromOffset(32, 32)
	avatar.Parent = entry
	do
		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(1, 0)
		c.Parent = avatar
	end

	local nameLabel = Instance.new("TextLabel")
	nameLabel.BackgroundTransparency = 1
	nameLabel.Position = UDim2.fromOffset(48, 5)
	nameLabel.Size = UDim2.new(1, -56, 0, 18)
	nameLabel.Font = Enum.Font.GothamBold
	nameLabel.Text = plr.DisplayName
	nameLabel.TextSize = 14
	nameLabel.TextColor3 = Color3.new(1, 1, 1)
	nameLabel.TextXAlignment = Enum.TextXAlignment.Left
	nameLabel.TextTruncate = Enum.TextTruncate.AtEnd
	nameLabel.Parent = entry

	local subLabel = Instance.new("TextLabel")
	subLabel.BackgroundTransparency = 1
	subLabel.Position = UDim2.fromOffset(48, 23)
	subLabel.Size = UDim2.new(1, -56, 0, 14)
	subLabel.Font = Enum.Font.Gotham
	subLabel.Text = "@" .. plr.Name
	subLabel.TextSize = 11
	subLabel.TextColor3 = Color3.fromRGB(130, 190, 150)
	subLabel.TextXAlignment = Enum.TextXAlignment.Left
	subLabel.TextTruncate = Enum.TextTruncate.AtEnd
	subLabel.Parent = entry

	task.spawn(function()
		local content = thumbCache[plr.UserId]
		if not content then
			local ok, result = pcall(function()
				return Players:GetUserThumbnailAsync(plr.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size48x48)
			end)
			if ok then
				content = result
				thumbCache[plr.UserId] = result
			end
		end
		if content and avatar.Parent then
			avatar.Image = content
		end
	end)

	entry.MouseEnter:Connect(function()
		TweenService:Create(entry, TweenInfo.new(0.15), { BackgroundColor3 = Color3.fromRGB(34, 86, 50) }):Play()
		TweenService:Create(stroke, TweenInfo.new(0.15), { Transparency = 0.15 }):Play()
	end)
	entry.MouseLeave:Connect(function()
		TweenService:Create(entry, TweenInfo.new(0.15), { BackgroundColor3 = Color3.fromRGB(22, 52, 32) }):Play()
		TweenService:Create(stroke, TweenInfo.new(0.15), { Transparency = 0.7 }):Play()
	end)
	entry.Activated:Connect(function()
		setPanel(false)
		shootPortal(plr)
	end)
end

local function refreshList(exclude)
	for _, child in ipairs(list:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end
	local others = {}
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player and plr ~= exclude then
			table.insert(others, plr)
		end
	end
	table.sort(others, function(a, b)
		return a.DisplayName:lower() < b.DisplayName:lower()
	end)
	for i, plr in ipairs(others) do
		makeEntry(plr, i)
	end
	emptyLabel.Visible = (#others == 0)
end

local redBtn, redStroke -- assigned below

setPanel = function(open)
	if open == panelOpen then return end
	panelOpen = open
	if redStroke then
		redStroke.Thickness = open and 3 or 1.5
		redStroke.Transparency = open and 0 or 0.55
	end
	if open then
		refreshList()
		panel.Visible = true
		TweenService:Create(panel, TweenInfo.new(0.28, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
			GroupTransparency = 0,
		}):Play()
		TweenService:Create(panelScale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
			Scale = 1,
		}):Play()
	else
		TweenService:Create(panel, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			GroupTransparency = 1,
		}):Play()
		TweenService:Create(panelScale, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Scale = 0.85,
		}):Play()
		task.delay(0.22, function()
			if not panelOpen then
				panel.Visible = false
			end
		end)
	end
end

Players.PlayerAdded:Connect(function()
	if panelOpen then refreshList() end
end)
Players.PlayerRemoving:Connect(function(plr)
	if panelOpen then refreshList(plr) end
end)

------------------------------------------------------------------------
-- CREATE THE THREE BUTTONS
------------------------------------------------------------------------
makeButton("TP", "TP", Color3.fromRGB(40, 140, 255), 1, "Teleport to nearest player", instantTeleport)
makeButton("SafeTP", "SAFE", Color3.fromRGB(40, 200, 90), 2, "Safe teleport (90 studs left)", safeTeleport)
redBtn, redStroke = makeButton("PortalMode", "PORT", Color3.fromRGB(235, 60, 60), 3, "Portal mode", function()
	setPanel(not panelOpen)
end)
