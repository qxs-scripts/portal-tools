local BUTTON_SIZE = 46

local bar = Instance.new("Frame")
bar.Name = "ButtonBar"
bar.AnchorPoint = Vector2.new(0, 0.5)
bar.Position = UDim2.new(0, 14, 0.5, 0)
bar.Size = UDim2.fromOffset(BUTTON_SIZE, BUTTON_SIZE * 3 + 10 * 2)
