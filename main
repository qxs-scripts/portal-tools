-- BLUE: instant teleport to the nearest player
local tpCooldown = false
local function instantTeleport()
	if tpCooldown then return end
	local root, _, char = getRoot(player)
	if not root then return end

	local best, bestDist
	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player then
			local oRoot = getRoot(other)
			if oRoot then
				local d = (oRoot.Position - root.Position).Magnitude
				if not bestDist or d < bestDist then
					best, bestDist = oRoot, d
				end
			end
		end
	end

	if not best then
		notify("No other players to teleport to")
		return
	end

	tpCooldown = true
	task.delay(0.4, function()
		tpCooldown = false
	end)

	local origin = root.Position
	local tPos = best.Position
	local back = -Vector3.new(best.CFrame.LookVector.X, 0, best.CFrame.LookVector.Z)
	back = back.Magnitude > 0.01 and back.Unit or Vector3.new(0, 0, 1)

	-- land 4 studs behind them, but never inside a wall
	local dist = 4
	local wall = Workspace:Raycast(tPos, back * 6, makeRayParams())
	if wall then
		dist = math.max(wall.Distance - 1.5, 1.5)
	end
	local dest = tPos + back * dist

	-- departure
	playSoundAt(CONFIG.SOUND_TP, origin, 1)
	screenFlash(CONFIG.BLUE, 0.15, 0.55)
	fovPop(22, 0.07, 0.6)
	departFx(origin, CONFIG.BLUE)
	warpBeam(origin, dest, CONFIG.BLUE)

	-- teleport
	root.CFrame = CFrame.lookAt(dest, Vector3.new(tPos.X, dest.Y, tPos.Z))
	root.AssemblyLinearVelocity = Vector3.zero

	-- arrival
	playSoundAt(CONFIG.SOUND_TP, dest, 1)
	teleportFx(dest, CONFIG.BLUE, char)
end

-- Used by Portal Mode: step through -> come out 20 studs behind the target
local function enterThroughPortal(targetPlayer)
	local root, _, char = getRoot(player)
	if not root then return false end
	local tRoot = getRoot(targetPlayer)
	if not tRoot or targetPlayer.Parent ~= Players then
		notify("Target is no longer available")
		return false
	end

	local tPos = tRoot.Position
	local back = -Vector3.new(tRoot.CFrame.LookVector.X, 0, tRoot.CFrame.LookVector.Z)
	back = back.Magnitude > 0.01 and back.Unit or Vector3.new(0, 0, 1)

	-- shorten if a wall is in the way
	local dist = CONFIG.BEHIND_DISTANCE
	local wall = Workspace:Raycast(tPos, back * (dist + 4), makeRayParams())
	if wall then
		dist = math.max(wall.Distance - 7, 2.5)
	end

	local facing = -back -- exit portal + player face the target
	local arrival = tPos + back * dist
	local exitPos = arrival + back * 4.5 + Vector3.new(0, PORTAL_LIFT, 0) -- portal sits just behind where you appear
	local entryPos = root.Position

	-- walked through
	playSoundAt(CONFIG.SOUND_ENTER, entryPos, 1)
	screenFlash(CONFIG.GREEN, 0.4, 0.55)
	departFx(entryPos, CONFIG.GREEN)

	local exitPortal = createPortal({
		cframe = CFrame.lookAt(exitPos, exitPos + facing),
	})
	exitPortal.close(CONFIG.CLOSE_DELAY)

	root.CFrame = CFrame.lookAt(arrival, arrival + facing)
	root.AssemblyLinearVelocity = Vector3.zero
	teleportFx(arrival, CONFIG.GREEN, char)
	return true
end

-- RED (after picking a target): shoot a portal
local function shootPortal(targetPlayer)
	local root = getRoot(player)
	if not root then return end
	if not getRoot(targetPlayer) then
		notify("That player isn't available")
		return
	end

	closeAllPortals()

	local origin = root.Position
	local flatLook = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
	if flatLook.Magnitude < 0.01 then
		flatLook = Vector3.new(0, 0, -1)
	end
	flatLook = flatLook.Unit

	-- check feet / waist / head height for a wall
	local params = makeRayParams()
	local nearest
	for _, yOff in ipairs({ -2, 0, 2.5 }) do
		local o = origin + Vector3.new(0, yOff, 0)
		local result = Workspace:Raycast(o, flatLook * (CONFIG.SHOOT_DISTANCE + 0.4), params)
		if result and (not nearest or result.Distance < nearest.Distance) then
			nearest = result
		end
	end

	local pos, facing
	if nearest then
		local n = Vector3.new(nearest.Normal.X, 0, nearest.Normal.Z)
		n = n.Magnitude < 0.2 and -flatLook or n.Unit
		pos = Vector3.new(nearest.Position.X, origin.Y + 0.3 + PORTAL_LIFT, nearest.Position.Z) + n * 0.4
		facing = n
	else
		pos = origin + flatLook * CONFIG.SHOOT_DISTANCE + Vector3.new(0, 0.3 + PORTAL_LIFT, 0)
		facing = -flatLook
	end

	createPortal({
		cframe = CFrame.lookAt(pos, pos + facing),
		origin = origin + flatLook * 1.0,
		onEnter = function()
			return enterThroughPortal(targetPlayer)
		end,
	})
end

-- GREEN: portal under you, fall through, land 90 studs to the left
local safeBusy = false
local function safeTeleport()
	if safeBusy then return end
	local root, hum, char = getRoot(player)
	if not root then return end
	safeBusy = true

	closeAllPortals()

	local startCF = root.CFrame
	local startPos = startCF.Position

	-- find the floor under us
	local floorHit = Workspace:Raycast(startPos, Vector3.new(0, -12, 0), makeRayParams())
	local rootHeight = (hum.RigType == Enum.HumanoidRigType.R15) and (hum.HipHeight + root.Size.Y / 2) or 3
	local floorPos = floorHit and floorHit.Position or (startPos - Vector3.new(0, rootHeight, 0))

	local entry = createPortal({
		cframe = flatCF(floorPos + Vector3.new(0, 0.12, 0)),
	})

	-- remember collisions so we can restore them after falling through the floor
	local saved = {}
	for _, part in ipairs(char:GetDescendants()) do
		if part:IsA("BasePart") then
			saved[part] = part.CanCollide
		end
	end
	local noclipConn

	local function restore()
		if noclipConn then
			noclipConn:Disconnect()
			noclipConn = nil
		end
		for part, value in pairs(saved) do
			if part.Parent then
				part.CanCollide = value
			end
		end
		if hum.Parent then
			hum.PlatformStand = false
			hum:ChangeState(Enum.HumanoidStateType.Freefall)
		end
		safeBusy = false
	end

	-- wait for the portal to finish opening
	while not entry.open and not entry.closed do
		task.wait()
	end
	if entry.closed or not root.Parent or hum.Health <= 0 then
		entry.close(0)
		safeBusy = false
		return
	end

	-- fall through the floor
	noclipConn = RunService.Stepped:Connect(function()
		for part in pairs(saved) do
			if part.Parent then
				part.CanCollide = false
			end
		end
	end)
	hum.PlatformStand = true
	root.AssemblyLinearVelocity = Vector3.new(0, -6, 0)

	local fallStart = os.clock()
	while root.Parent and hum.Health > 0 and root.Position.Y > floorPos.Y - 1.2 and os.clock() - fallStart < 1.6 do
		RunService.Heartbeat:Wait()
	end

	if not root.Parent or hum.Health <= 0 then
		restore()
		entry.close(0)
		return
	end

	-- we went through the portal
	playSoundAt(CONFIG.SOUND_ENTER, floorPos, 1)
	screenFlash(CONFIG.GREEN, 0.4, 0.55)
	departFx(floorPos + Vector3.new(0, 3, 0), CONFIG.GREEN)
	entry.used = true
	entry.close(CONFIG.CLOSE_DELAY)

	-- destination: 90 studs to the left, snapped to the ground
	local left = -startCF.RightVector
	left = Vector3.new(left.X, 0, left.Z).Unit
	local destFlat = startPos + left * CONFIG.SAFE_TP_DISTANCE
	local down = Workspace:Raycast(Vector3.new(destFlat.X, startPos.Y + 8, destFlat.Z), Vector3.new(0, -80, 0), makeRayParams())
	local destRootPos = down and (down.Position + Vector3.new(0, rootHeight + 0.4, 0)) or destFlat
	local destFloor = destRootPos - Vector3.new(0, rootHeight, 0)

	root.CFrame = CFrame.new(destRootPos) * startCF.Rotation
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero

	local exitPortal = createPortal({
		cframe = flatCF(destFloor + Vector3.new(0, 0.12, 0)),
	})
	exitPortal.close(CONFIG.CLOSE_DELAY)

	teleportFx(destRootPos, CONFIG.GREEN, char)
	restore()
end

