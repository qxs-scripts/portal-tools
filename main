-- This is an open-source, vibecoded project.

--[[
	PORTAL TOOLS  -  single LocalScript

	SETUP: Insert a LocalScript into StarterGui and paste this in. Nothing else is needed.

	Buttons (left side of the screen):
		BLUE  (TP)   - instantly teleport to the nearest player (blue flash + wind)
		GREEN (SAFE) - portal opens under you, you fall through, land 90 studs to your left
		RED   (PORT) - opens a player list; click a player to shoot a portal 5 studs in front of you
		               (or at the wall if one is in the way). Step through it and you come out
		               20 studs behind that player.

	LOOK: Rick-and-Morty style portals (swirling image layers, glowing rim, orbiting light
	ribbons, white / light-green / dark-green particles) and cinematic teleports (light pillar,
	rising rings, helix of light, shockwave, bloom + blur punch). Tweak sizes/speeds in CONFIG.

	NOTE: Everything here is client-side, so the visual effects/sounds are only seen by YOU.
	Other players just see your character move.
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")


------------------------------------------------------------------------
-- CONFIG
------------------------------------------------------------------------
local CONFIG = {
	PORTAL_IMAGE = "rbxassetid://81558332228414",

	SOUND_PORTAL = "rbxassetid://1013378689",        -- portal open / close
	SOUND_TP     = "rbxassetid://124934430745275",   -- instant (blue) teleport
	SOUND_ENTER  = "rbxassetid://84183563421633",    -- walked through a portal

	PORTAL_SIZE     = 9.75,  -- studs (was 6.5, now 1.5x bigger)
	SHOOT_DISTANCE  = 5,     -- studs in front of the player
	BEHIND_DISTANCE = 20,    -- studs behind the target player
	SAFE_TP_DISTANCE = 90,   -- studs to the left
	CLOSE_DELAY     = 3,     -- seconds before a used portal closes
	SPIN_SPEED      = 190,   -- degrees per second (was 110)

	-- Screen-level polish (client only). Turn off if you ever want it calmer.
	SCREEN_FX    = true,     -- bloom / blur / colour punch on teleports
	CAMERA_SHAKE = true,     -- tiny camera kick on arrival

	GREEN = Color3.fromRGB(60, 255, 110),
	BLUE  = Color3.fromRGB(70, 170, 255),
	RED   = Color3.fromRGB(255, 70, 70),

	-- Portal palette: dark green + light green + glowing white
	GREEN_DARK  = Color3.fromRGB(8, 110, 42),
	GREEN_LIGHT = Color3.fromRGB(165, 255, 180),
}

local SMOKE_TEX = "rbxasset://textures/particles/smoke_main.dng"
local SPARK_TEX = "rbxasset://textures/particles/sparkles_main.dng"
-- Soft glowing blobs. Uses the smoke texture + full LightEmission so it reads as a glow.
-- If you have a soft round-glow texture ID you like, drop it in here.
local GLOW_TEX  = SMOKE_TEX


------------------------------------------------------------------------
-- CLEANUP FROM PREVIOUS RUNS (respawn safe)
------------------------------------------------------------------------
local oldGui = playerGui:FindFirstChild("PortalTools")
if oldGui then oldGui:Destroy() end
local oldFx = Workspace:FindFirstChild("ClientPortalFx")
if oldFx then oldFx:Destroy() end

local fx = Instance.new("Folder")
fx.Name = "ClientPortalFx"
fx.Parent = Workspace

------------------------------------------------------------------------
-- BASE GUI (flash overlay + toast are needed by the effects)
------------------------------------------------------------------------
local gui = Instance.new("ScreenGui")
gui.Name = "PortalTools"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.DisplayOrder = 50
gui.Parent = playerGui

local flash = Instance.new("Frame")
flash.Name = "Flash"
flash.Size = UDim2.fromScale(1, 1)
flash.BackgroundTransparency = 1
flash.BorderSizePixel = 0
flash.Active = false
flash.ZIndex = 100
flash.Parent = gui

local function screenFlash(color, startTransparency, duration)
	flash.BackgroundColor3 = color
	flash.BackgroundTransparency = startTransparency
	TweenService:Create(flash, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		BackgroundTransparency = 1,
	}):Play()
end

local toast = Instance.new("TextLabel")
toast.Name = "Toast"
toast.AnchorPoint = Vector2.new(0.5, 1)
toast.Position = UDim2.new(0.5, 0, 1, -90)
toast.AutomaticSize = Enum.AutomaticSize.X
toast.Size = UDim2.fromOffset(0, 34)
toast.BackgroundColor3 = Color3.fromRGB(14, 18, 16)
toast.BackgroundTransparency = 1
toast.TextTransparency = 1
toast.TextColor3 = Color3.new(1, 1, 1)
toast.Font = Enum.Font.GothamMedium
toast.TextSize = 14
toast.Text = ""
toast.ZIndex = 90
toast.Parent = gui
do
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 14)
	pad.PaddingRight = UDim.new(0, 14)
	pad.Parent = toast
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 10)
	corner.Parent = toast
end

local toastToken = 0
local function notify(text)
	toastToken += 1
	local mine = toastToken
	toast.Text = text
	toast.BackgroundTransparency = 0.2
	toast.TextTransparency = 0
	task.delay(2, function()
		if mine ~= toastToken then return end
		TweenService:Create(toast, TweenInfo.new(0.3), {
			BackgroundTransparency = 1,
			TextTransparency = 1,
		}):Play()
	end)
end

------------------------------------------------------------------------
-- HELPERS
------------------------------------------------------------------------
local function getRoot(plr)
	local char = plr.Character
	if not char then return nil end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart")
	if root and hum and hum.Health > 0 then
		return root, hum, char
	end
	return nil
end

local function makeRayParams()
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local list = { fx }
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr.Character then
			table.insert(list, plr.Character)
		end
	end
	params.FilterDescendantsInstances = list
	params.IgnoreWater = true
	params.RespectCanCollide = true
	return params
end

local function newFxPart(size, cf)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Massless = true
	p.Transparency = 1
	p.Size = size
	p.CFrame = cf
	p.Parent = fx
	return p
end

-- A CFrame lying flat, with its front face pointing up.
local function flatCF(pos)
	return CFrame.lookAt(pos, pos + Vector3.yAxis, Vector3.zAxis)
end

local function playSoundAt(id, position, volume, speed)
	local holder = newFxPart(Vector3.new(0.2, 0.2, 0.2), CFrame.new(position))
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = volume or 1
	s.PlaybackSpeed = speed or 1
	s.RollOffMinDistance = 25
	s.RollOffMaxDistance = 160
	s.Parent = holder
	s:Play()
	Debris:AddItem(holder, 10)
end

------------------------------------------------------------------------
-- EFFECT HELPERS
------------------------------------------------------------------------
local WHITE = Color3.new(1, 1, 1)
local GREEN_DARK = CONFIG.GREEN_DARK
local GREEN_LIGHT = CONFIG.GREEN_LIGHT

-- A portal is 6.5 studs originally. Bigger portals are lifted so the bottom
-- edge still touches the ground exactly where it used to.
local PORTAL_LIFT = CONFIG.PORTAL_SIZE / 2 - 3.25

local function rand(a, b)
	return a + math.random() * (b - a)
end

local function tint(color, amount)
	return color:Lerp(WHITE, amount)
end

local function shade(color, amount)
	return color:Lerp(Color3.new(0, 0, 0), amount)
end

-- seq(t0, v0, t1, v1, ...) -> NumberSequence
local function seq(...)
	local args = { ... }
	local points = {}
	for i = 1, #args, 2 do
		table.insert(points, NumberSequenceKeypoint.new(args[i], args[i + 1]))
	end
	return NumberSequence.new(points)
end

-- cseq(t0, c0, t1, c1, ...) -> ColorSequence
local function cseq(...)
	local args = { ... }
	local points = {}
	for i = 1, #args, 2 do
		table.insert(points, ColorSequenceKeypoint.new(args[i], args[i + 1]))
	end
	return ColorSequence.new(points)
end

local function tween(inst, time, props, style, dir)
	local tw = TweenService:Create(inst, TweenInfo.new(
		time,
		style or Enum.EasingStyle.Quad,
		dir or Enum.EasingDirection.Out
	), props)
	tw:Play()
	return tw
end

local function newEmitter(parent, props)
	local e = Instance.new("ParticleEmitter")
	e.Rate = 0
	e.LightInfluence = 0
	for k, v in pairs(props) do
		e[k] = v
	end
	e.Parent = parent
	return e
end

-- Glowing ribbon that follows a moving part (solid colour, tapers + fades).
local function makeTrail(part, color, lifetime, width, glow)
	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(0, width / 2, 0)
	a0.Parent = part
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, -width / 2, 0)
	a1.Parent = part

	local tr = Instance.new("Trail")
	tr.Attachment0 = a0
	tr.Attachment1 = a1
	tr.Lifetime = lifetime
	tr.MinLength = 0.02
	tr.FaceCamera = true
	tr.LightEmission = glow
	tr.LightInfluence = 0
	tr.Color = cseq(0, tint(color, glow * 0.6), 0.35, color, 1, shade(color, 0.5))
	tr.Transparency = seq(0, 0, 0.6, 0.4, 1, 1)
	tr.WidthScale = seq(0, 1, 1, 0)
	tr.Parent = part
	return tr
end

------------------------------------------------------------------------
-- SCREEN-LEVEL EFFECTS
------------------------------------------------------------------------

-- Quick bloom + blur + colour punch that eases out.
local function screenFx(color, power)
	if not CONFIG.SCREEN_FX then return end
	power = power or 1

	local cc = Instance.new("ColorCorrectionEffect")
	cc.TintColor = tint(color, 0.45)
	cc.Brightness = 0.1 * power
	cc.Contrast = 0.2 * power
	cc.Saturation = 0.35 * power
	cc.Parent = Lighting

	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 1.5 * power
	bloom.Size = 30
	bloom.Threshold = 0.8
	bloom.Parent = Lighting

	local blur = Instance.new("BlurEffect")
	blur.Size = 12 * power
	blur.Parent = Lighting

	local time = 0.75
	tween(cc, time, { TintColor = WHITE, Brightness = 0, Contrast = 0, Saturation = 0 }, Enum.EasingStyle.Quint)
	tween(bloom, time, { Intensity = 0 }, Enum.EasingStyle.Quint)
	tween(blur, time * 0.8, { Size = 0 }, Enum.EasingStyle.Quint)
	Debris:AddItem(cc, time + 0.1)
	Debris:AddItem(bloom, time + 0.1)
	Debris:AddItem(blur, time + 0.1)
end

local shaking = false
local function cameraShake(intensity, duration)
	local cam = Workspace.CurrentCamera
	if not CONFIG.CAMERA_SHAKE or not cam or shaking then return end
	shaking = true
	local started = os.clock()
	RunService:BindToRenderStep("PortalToolsShake", Enum.RenderPriority.Camera.Value + 1, function()
		local a = (os.clock() - started) / duration
		if a >= 1 then
			RunService:UnbindFromRenderStep("PortalToolsShake")
			shaking = false
			return
		end
		local k = (1 - a) * (1 - a) * intensity
		cam.CFrame = cam.CFrame * CFrame.Angles(
			(math.random() - 0.5) * 0.02 * k,
			(math.random() - 0.5) * 0.02 * k,
			(math.random() - 0.5) * 0.01 * k
		)
	end)
end

local fovBusy = false
local function fovPop(amount, inTime, outTime)
	local cam = Workspace.CurrentCamera
	if not cam or fovBusy then return end
	fovBusy = true
	task.spawn(function()
		local base = cam.FieldOfView
		tween(cam, inTime, { FieldOfView = base + amount }, Enum.EasingStyle.Quint, Enum.EasingDirection.Out).Completed:Wait()
		tween(cam, outTime, { FieldOfView = base }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut).Completed:Wait()
		fovBusy = false
	end)
end

------------------------------------------------------------------------
-- WORLD EFFECTS
------------------------------------------------------------------------

-- Two-layer ring (soft coloured glow + white-hot core) drawn on a thin part.
-- Returns the list of { frame, stroke } layers so callers can animate them.
local function buildRing(part, color, frac, thickness)
	local layers = {}
	local defs = {
		{ c = color, mult = 2.4, tr = 0.6 },
		{ c = tint(color, 0.8), mult = 1, tr = 0 },
	}
	for _, face in ipairs({ Enum.NormalId.Front, Enum.NormalId.Back }) do
		local sg = Instance.new("SurfaceGui")
		sg.Face = face
		sg.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
		sg.CanvasSize = Vector2.new(512, 512)
		sg.LightInfluence = 0
		sg.Brightness = 3
		sg.Adornee = part
		sg.Parent = part

		for _, def in ipairs(defs) do
			local f = Instance.new("Frame")
			f.AnchorPoint = Vector2.new(0.5, 0.5)
			f.Position = UDim2.fromScale(0.5, 0.5)
			f.Size = UDim2.fromScale(frac, frac)
			f.BackgroundTransparency = 1
			f.BorderSizePixel = 0
			f.Parent = sg

			local corner = Instance.new("UICorner")
			corner.CornerRadius = UDim.new(0.5, 0)
			corner.Parent = f

			local stroke = Instance.new("UIStroke")
			stroke.Color = def.c
			stroke.Thickness = thickness * 2 * def.mult
			stroke.Transparency = def.tr
			stroke.Parent = f

			table.insert(layers, { frame = f, stroke = stroke })
		end
	end
	return layers
end

-- Expanding (or, with endFrac small + direction In, collapsing) shockwave ring.
local function ringEffect(cf, diameter, color, duration, startFrac, thickness, endFrac, direction)
	local part = newFxPart(Vector3.new(diameter, diameter, 0.05), cf)
	local layers = buildRing(part, color, startFrac, thickness or 8)
	local e = endFrac or 0.86
	for _, l in ipairs(layers) do
		tween(l.frame, duration, { Size = UDim2.fromScale(e, e) }, Enum.EasingStyle.Quint, direction or Enum.EasingDirection.Out)
		tween(l.stroke, duration, { Transparency = 1 }, Enum.EasingStyle.Sine, Enum.EasingDirection.In)
		tween(l.stroke, duration, { Thickness = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	end
	Debris:AddItem(part, duration + 0.15)
end

-- A ring that floats upward (like a scanner sweeping over the character).
local function risingRing(feet, color, diameter, delay, rise, duration)
	task.delay(delay, function()
		local part = newFxPart(Vector3.new(diameter, diameter, 0.05), flatCF(feet + Vector3.new(0, 0.15, 0)))
		local layers = buildRing(part, color, 0.84, 7)
		tween(part, duration, { CFrame = flatCF(feet + Vector3.new(0, rise, 0)) }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		for _, l in ipairs(layers) do
			tween(l.stroke, duration, { Transparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		end
		Debris:AddItem(part, duration + 0.15)
	end)
end

-- Flat glowing disc that blooms outward (portal opening flash).
local function discFlash(cf, diameter, color, duration, startTransparency)
	local d = newFxPart(Vector3.new(0.05, 0.5, 0.5), cf * CFrame.Angles(0, math.rad(90), 0))
	d.Shape = Enum.PartType.Cylinder
	d.Material = Enum.Material.Neon
	d.Color = color
	d.Transparency = startTransparency or 0.2
	tween(d, duration, {
		Size = Vector3.new(0.05, diameter, diameter),
		Transparency = 1,
	}, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
	Debris:AddItem(d, duration + 0.1)
end

-- Beam of light shooting up from the ground and collapsing.
local function lightPillar(feet, color, height, duration)
	local function cylinder(diameter, c, startTransparency, life)
		local part = newFxPart(
			Vector3.new(height, diameter, diameter),
			CFrame.new(feet + Vector3.new(0, height / 2, 0)) * CFrame.Angles(0, 0, math.rad(90))
		)
		part.Shape = Enum.PartType.Cylinder
		part.Material = Enum.Material.Neon
		part.Color = c
		part.Transparency = startTransparency
		tween(part, life, {
			Size = Vector3.new(height, 0.05, 0.05),
			Transparency = 1,
		}, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
		Debris:AddItem(part, life + 0.1)
	end
	cylinder(4.4, color, 0.5, duration)
	cylinder(2.2, WHITE, 0.1, duration * 0.7)
end

-- Fast expanding energy spheres (white core + coloured shell).
local function shockwave(position, color, maxDiameter, duration)
	local function sphere(c, startTransparency, diameter, life)
		local ball = newFxPart(Vector3.one, CFrame.new(position))
		ball.Shape = Enum.PartType.Ball
		ball.Material = Enum.Material.Neon
		ball.Color = c
		ball.Transparency = startTransparency
		tween(ball, life, {
			Size = Vector3.one * diameter,
			Transparency = 1,
		}, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
		Debris:AddItem(ball, life + 0.1)
	end
	sphere(color, 0.45, maxDiameter, duration)
	sphere(WHITE, 0.2, maxDiameter * 0.55, duration * 0.6)
end

-- Spiralling double-helix of glowing ribbons.
local function windVortex(position, color, duration)
	local count = 10
	local runners = {}
	for i = 1, count do
		local dir = (i % 2 == 0) and 1 or -1
		local angle = (i / count) * math.pi * 2 + rand(0, 0.5)
		local height = rand(-3.2, -0.6)
		local radius = (dir == 1) and rand(3.0, 4.0) or rand(1.8, 2.6)

		local startPos = position + Vector3.new(math.cos(angle) * radius, height, math.sin(angle) * radius)
		local part = newFxPart(Vector3.one * 0.2, CFrame.new(startPos))
		local c = (i % 3 == 0) and WHITE or ((i % 3 == 1) and tint(color, 0.5) or color)
		local trail = makeTrail(part, c, rand(0.3, 0.45), rand(0.2, 0.34), 1)

		runners[i] = {
			part = part,
			trail = trail,
			angle = angle,
			height = height,
			radius = radius,
			speed = dir * rand(11, 17),
			rise = rand(7, 13),
		}
	end

	local t0 = os.clock()
	local conn
	conn = RunService.Heartbeat:Connect(function()
		local t = os.clock() - t0
		local a = t / duration
		if a >= 1 then
			conn:Disconnect()
			for _, d in ipairs(runners) do
				d.trail.Enabled = false
				Debris:AddItem(d.part, 0.7)
			end
			return
		end
		for _, d in ipairs(runners) do
			local ang = d.angle + t * d.speed
			local r = d.radius * (1 - 0.5 * a)
			d.part.CFrame = CFrame.new(position + Vector3.new(math.cos(ang) * r, d.height + t * d.rise, math.sin(ang) * r))
			if a > 0.75 then
				d.trail.Enabled = false
			end
		end
	end)
end

-- Layered burst: white-hot flash, arcing sparks, soft glow puffs, floating glints.
local function particleBurst(position, color, count)
	local p = newFxPart(Vector3.one * 0.5, CFrame.new(position))

	local core = newEmitter(p, {
		Texture = GLOW_TEX,
		Color = ColorSequence.new(WHITE, tint(color, 0.5)),
		LightEmission = 1,
		Size = seq(0, 4, 1, 14),
		Transparency = seq(0, 0.05, 0.4, 0.45, 1, 1),
		Lifetime = NumberRange.new(0.25, 0.3),
		Speed = NumberRange.new(0),
	})

	local sparks = newEmitter(p, {
		Texture = SPARK_TEX,
		Color = cseq(0, WHITE, 0.35, tint(color, 0.4), 1, color),
		LightEmission = 1,
		Size = seq(0, 1.0, 0.6, 0.55, 1, 0),
		Transparency = seq(0, 0, 0.7, 0.15, 1, 1),
		Lifetime = NumberRange.new(0.5, 1.1),
		Speed = NumberRange.new(14, 34),
		SpreadAngle = Vector2.new(180, 180),
		Drag = 2.5,
		Acceleration = Vector3.new(0, -14, 0),
		Rotation = NumberRange.new(0, 360),
	})

	local puff = newEmitter(p, {
		Texture = SMOKE_TEX,
		Color = cseq(0, tint(color, 0.6), 0.5, color, 1, shade(color, 0.5)),
		LightEmission = 0.9,
		Size = seq(0, 2, 1, 9),
		Transparency = seq(0, 0.25, 1, 1),
		Lifetime = NumberRange.new(0.45, 0.9),
		Speed = NumberRange.new(12, 26),
		SpreadAngle = Vector2.new(180, 180),
		Drag = 4,
		Rotation = NumberRange.new(0, 360),
		RotSpeed = NumberRange.new(-90, 90),
	})

	local glints = newEmitter(p, {
		Texture = SPARK_TEX,
		Color = ColorSequence.new(WHITE, tint(color, 0.5)),
		LightEmission = 1,
		Size = seq(0, 0.4, 0.5, 0.3, 1, 0),
		Transparency = seq(0, 0, 0.6, 0.2, 1, 1),
		Lifetime = NumberRange.new(0.9, 1.6),
		Speed = NumberRange.new(2, 7),
		SpreadAngle = Vector2.new(180, 180),
		Drag = 1.5,
		Acceleration = Vector3.new(0, 4, 0),
		Rotation = NumberRange.new(0, 360),
	})

	local light = Instance.new("PointLight")
	light.Color = color
	light.Brightness = 10
	light.Range = 34
	light.Parent = p
	tween(light, 0.55, { Brightness = 0 })

	core:Emit(1)
	sparks:Emit(count)
	puff:Emit(math.floor(count * 0.35))
	glints:Emit(math.floor(count * 0.5))
	Debris:AddItem(p, 2.2)
end

-- Ring of sparks fired outward (or sucked inward) around a portal rim.
-- Uses one little emitter per slot so every spark starts at a different spot.
local function rimBurst(cf, radius, inward, count)
	local slots = 18
	for i = 1, slots do
		local ang = (i / slots) * math.pi * 2
		local c, s = math.cos(ang), math.sin(ang)
		local out = cf.RightVector * c + cf.UpVector * s
		local tangent = cf.RightVector * -s + cf.UpVector * c
		local holder = newFxPart(Vector3.one * 0.2, CFrame.fromMatrix(cf.Position + out * radius, tangent, out))
		local direction = inward and Enum.NormalId.Bottom or Enum.NormalId.Top

		local sp = newEmitter(holder, {
			Texture = SPARK_TEX,
			Color = cseq(0, WHITE, 0.4, GREEN_LIGHT, 1, CONFIG.GREEN),
			LightEmission = 1,
			Size = seq(0, 0.8, 0.6, 0.45, 1, 0),
			Transparency = seq(0, 0, 0.7, 0.2, 1, 1),
			Lifetime = inward and NumberRange.new(0.35, 0.5) or NumberRange.new(0.45, 0.9),
			Speed = inward and NumberRange.new(10, 15) or NumberRange.new(8, 22),
			SpreadAngle = Vector2.new(22, 22),
			Drag = inward and 0 or 2,
			EmissionDirection = direction,
			Rotation = NumberRange.new(0, 360),
		})
		local gl = newEmitter(holder, {
			Texture = GLOW_TEX,
			Color = cseq(0, WHITE, 0.4, GREEN_LIGHT, 1, GREEN_DARK),
			LightEmission = 1,
			Size = seq(0, 1, 1, 3.4),
			Transparency = seq(0, 0.4, 1, 1),
			Lifetime = NumberRange.new(0.4, 0.7),
			Speed = NumberRange.new(2, 7),
			SpreadAngle = Vector2.new(40, 40),
			EmissionDirection = direction,
			Rotation = NumberRange.new(0, 360),
		})
		sp:Emit(count)
		gl:Emit(1)
		Debris:AddItem(holder, 1.5)
	end
end

-- Character glows white-hot, then settles into the effect colour as it fades.
local function highlightChar(char, color, duration)
	local h = Instance.new("Highlight")
	h.FillColor = WHITE
	h.OutlineColor = tint(color, 0.35)
	h.FillTransparency = 0.05
	h.OutlineTransparency = 0
	h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	h.Parent = char
	tween(h, duration, {
		FillColor = color,
		FillTransparency = 1,
		OutlineTransparency = 1,
	}, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	Debris:AddItem(h, duration + 0.1)
end

-- A streak of light connecting two points (instant-teleport trail).
local function warpBeam(from, to, color)
	local a = newFxPart(Vector3.one * 0.2, CFrame.new(from))
	local b = newFxPart(Vector3.one * 0.2, CFrame.new(to))
	local a0 = Instance.new("Attachment")
	a0.Parent = a
	local a1 = Instance.new("Attachment")
	a1.Parent = b

	local beam = Instance.new("Beam")
	beam.Attachment0 = a0
	beam.Attachment1 = a1
	beam.Color = ColorSequence.new(tint(color, 0.7), color)
	beam.LightEmission = 1
	beam.LightInfluence = 0
	beam.FaceCamera = true
	beam.Segments = 1
	beam.Width0 = 2.2
	beam.Width1 = 2.2
	beam.Transparency = NumberSequence.new(0.1)
	beam.Parent = a
	tween(beam, 0.55, { Width0 = 0, Width1 = 0 }, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
	Debris:AddItem(a, 0.7)
	Debris:AddItem(b, 0.7)
end

-- You vanish: light pillar, collapsing rings, vortex, burst.
local function departFx(position, color)
	local feet = position - Vector3.new(0, 2.8, 0)
	lightPillar(feet, color, 22, 0.5)
	ringEffect(flatCF(feet + Vector3.new(0, 0.1, 0)), 24, color, 0.5, 0.1, 10)
	risingRing(feet, color, 6, 0, 7, 0.4)
	risingRing(feet, WHITE, 5, 0.06, 7.5, 0.4)
	windVortex(position, color, 0.6)
	particleBurst(position, color, 40)
	shockwave(position, color, 16, 0.35)
end

-- You appear: bigger version of the above + screen punch.
local function teleportFx(position, color, char)
	local feet = position - Vector3.new(0, 2.8, 0)
	local ground = feet + Vector3.new(0, 0.1, 0)
	lightPillar(feet, color, 26, 0.65)
	ringEffect(flatCF(ground), 30, color, 0.6, 0.1, 10)
	ringEffect(flatCF(ground + Vector3.new(0, 0.05, 0)), 20, WHITE, 0.45, 0.1, 8)
	risingRing(feet, color, 7, 0, 8, 0.55)
	risingRing(feet, color, 6, 0.08, 8.5, 0.55)
	risingRing(feet, WHITE, 5, 0.16, 9, 0.5)
	windVortex(position, color, 0.8)
	particleBurst(position, color, 55)
	shockwave(position, color, 22, 0.45)
	if char then
		highlightChar(char, color, 0.8)
	end
	screenFx(color, 1)
	cameraShake(1.2, 0.35)
end

------------------------------------------------------------------------
-- PORTAL OBJECT
------------------------------------------------------------------------
local activePortals = {}

local function closeAllPortals()
	for portal in pairs(activePortals) do
		portal.close(0)
	end
end

-- Layers of the swirling portal image (spin multiplier, size, opacity).
local LAYER_DEFS = {
	{ scale = 1.00, spin = 1.00,  transparency = 0 },
	{ scale = 0.80, spin = -1.45, transparency = 0.45 },
	{ scale = 0.58, spin = 2.10,  transparency = 0.6 },
}

-- Glowing ribbons that orbit inside the portal (r = fraction of the radius).
local ORBITS = {
	{ r = 0.97, speed = 3.4,  color = WHITE,        life = 0.5,  width = 0.36, glow = 1,    phase = 0 },
	{ r = 0.97, speed = 3.4,  color = WHITE,        life = 0.5,  width = 0.36, glow = 1,    phase = math.pi },
	{ r = 0.88, speed = -4.6, color = GREEN_LIGHT,  life = 0.45, width = 0.30, glow = 1,    phase = 1.3 },
	{ r = 0.88, speed = -4.6, color = GREEN_LIGHT,  life = 0.45, width = 0.30, glow = 1,    phase = 4.4 },
	{ r = 0.74, speed = 6.2,  color = CONFIG.GREEN, life = 0.40, width = 0.28, glow = 0.8,  phase = 2.2 },
	{ r = 0.62, speed = -7.4, color = GREEN_DARK,   life = 0.40, width = 0.34, glow = 0.15, phase = 5.1 },
	{ r = 0.50, speed = 8.6,  color = GREEN_DARK,   life = 0.35, width = 0.30, glow = 0.15, phase = 0.7 },
}

-- Rim of the portal: soft halo + coloured band + white-hot edge, each with a moving gradient.
local RIM_DEFS = {
	{ frac = 0.74, thick = 40, tr = 0.72, gspeed = 60,
		grad = cseq(0, GREEN_DARK, 0.5, CONFIG.GREEN, 1, GREEN_DARK) },
	{ frac = 0.74, thick = 16, tr = 0.35, gspeed = -110,
		grad = cseq(0, CONFIG.GREEN, 0.35, GREEN_LIGHT, 0.7, CONFIG.GREEN, 1, CONFIG.GREEN) },
	{ frac = 0.74, thick = 6, tr = 0,    gspeed = 150,
		grad = cseq(0, WHITE, 0.3, GREEN_LIGHT, 0.55, WHITE, 0.8, GREEN_LIGHT, 1, WHITE) },
}

--[[
	cfg.cframe   : CFrame, LookVector = direction the portal faces
	cfg.origin   : Vector3 (optional) - where the glowing ball is shot from
	cfg.onEnter  : function(portal) -> boolean (optional) - makes the portal usable;
	               return true when the player was actually teleported
]]
local function createPortal(cfg)
	local cf = cfg.cframe
	local pos = cf.Position
	local size = CONFIG.PORTAL_SIZE
	local radius = size / 2

	local portal = {
		open = false, armed = false, closed = false, used = false, busy = false,
		closing = false, emitting = false, openedAt = nil, closeAt = nil,
	}
	activePortals[portal] = true

	local model = Instance.new("Folder")
	model.Name = "Portal"
	model.Parent = fx

	local scaleValue = Instance.new("NumberValue")
	scaleValue.Name = "Scale"
	scaleValue.Value = 0
	scaleValue.Parent = model

	-- Image part: three counter-rotating layers of the portal image on both faces
	local core = newFxPart(Vector3.new(size, size, 0.1), cf)
	core.Name = "PortalImage"
	core.Parent = model

	local layers = {}
	for idx, def in ipairs(LAYER_DEFS) do
		layers[idx] = { def = def, rot = (idx - 1) * 70, imgs = {} }
	end
	for _, face in ipairs({ Enum.NormalId.Front, Enum.NormalId.Back }) do
		local sg = Instance.new("SurfaceGui")
		sg.Face = face
		sg.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
		sg.CanvasSize = Vector2.new(768, 768)
		sg.LightInfluence = 0
		sg.Brightness = 2.2
		sg.Adornee = core
		sg.Parent = core

		for idx, layer in ipairs(layers) do
			local img = Instance.new("ImageLabel")
			img.AnchorPoint = Vector2.new(0.5, 0.5)
			img.Position = UDim2.fromScale(0.5, 0.5)
			img.Size = UDim2.fromScale(0, 0)
			img.BackgroundTransparency = 1
			img.Image = CONFIG.PORTAL_IMAGE
			img.ImageTransparency = layer.def.transparency
			img.ScaleType = Enum.ScaleType.Fit
			img.ZIndex = idx
			img.Parent = sg
			table.insert(layer.imgs, img)
		end
	end

	-- Glowing rim (slightly thicker slab so it never z-fights with the image)
	local rim = newFxPart(Vector3.new(size * 1.3, size * 1.3, 0.14), cf)
	rim.Name = "PortalRim"
	rim.Parent = model

	local rimRings = {}
	for _, face in ipairs({ Enum.NormalId.Front, Enum.NormalId.Back }) do
		local sg = Instance.new("SurfaceGui")
		sg.Face = face
		sg.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
		sg.CanvasSize = Vector2.new(512, 512)
		sg.LightInfluence = 0
		sg.Brightness = 3
		sg.Adornee = rim
		sg.Parent = rim

		for idx, def in ipairs(RIM_DEFS) do
			local f = Instance.new("Frame")
			f.AnchorPoint = Vector2.new(0.5, 0.5)
			f.Position = UDim2.fromScale(0.5, 0.5)
			f.Size = UDim2.fromScale(0, 0)
			f.BackgroundTransparency = 1
			f.BorderSizePixel = 0
			f.ZIndex = idx
			f.Parent = sg

			local corner = Instance.new("UICorner")
			corner.CornerRadius = UDim.new(0.5, 0)
			corner.Parent = f

			local stroke = Instance.new("UIStroke")
			stroke.Color = WHITE
			stroke.Thickness = 0
			stroke.Transparency = def.tr
			stroke.Parent = f

			local gradient = Instance.new("UIGradient")
			gradient.Color = def.grad
			gradient.Parent = stroke

			table.insert(rimRings, { frame = f, stroke = stroke, gradient = gradient, def = def, phase = idx * 1.7 })
		end
	end

	-- Glow disc sandwiched inside the image slab (pulses dark green <-> bright green)
	local glow = newFxPart(Vector3.new(0.04, size, size), cf * CFrame.Angles(0, math.rad(90), 0))
	glow.Shape = Enum.PartType.Cylinder
	glow.Material = Enum.Material.Neon
	glow.Color = CONFIG.GREEN
	glow.Transparency = 0.8
	glow.Parent = model

	-- Light
	local light = Instance.new("PointLight")
	light.Color = CONFIG.GREEN
	light.Range = 27
	light.Brightness = 0
	light.Parent = core

	-- Orbiting light ribbons (white / light green / dark green)
	local orbiters = {}
	for i, def in ipairs(ORBITS) do
		local startPos = pos + cf.RightVector * (math.cos(def.phase) * radius * def.r)
			+ cf.UpVector * (math.sin(def.phase) * radius * def.r)
		local part = newFxPart(Vector3.one * 0.2, CFrame.new(startPos))
		part.Parent = model
		local trail = makeTrail(part, def.color, def.life, def.width, def.glow)
		trail.Enabled = false
		orbiters[i] = { part = part, trail = trail, def = def, ang = def.phase, r = def.r, speed = def.speed, phase = def.phase }
	end

	-- Emitters. Positions are randomised per frame in the Heartbeat below.
	local rimHolder = newFxPart(Vector3.one * 0.2, cf)
	rimHolder.Parent = model
	local suckHolder = newFxPart(Vector3.one * 0.2, cf)
	suckHolder.Parent = model
	local faceHolder = newFxPart(Vector3.one * 0.2, cf)
	faceHolder.Parent = model

	local k = size / 6.5 -- particle size multiplier vs. the original portal

	-- sparks spraying off the rim (white -> light green -> green)
	local rimSparks = newEmitter(rimHolder, {
		Texture = SPARK_TEX,
		Color = cseq(0, WHITE, 0.4, GREEN_LIGHT, 1, CONFIG.GREEN),
		LightEmission = 1,
		Size = seq(0, 0.55, 0.5, 0.3, 1, 0),
		Transparency = seq(0, 0, 0.7, 0.2, 1, 1),
		Lifetime = NumberRange.new(0.5, 1.1),
		Speed = NumberRange.new(2, 8),
		SpreadAngle = Vector2.new(35, 35),
		EmissionDirection = Enum.NormalId.Top,
		Drag = 1.5,
		Acceleration = Vector3.new(0, 2.5, 0),
		Rotation = NumberRange.new(0, 360),
	})

	-- soft glowing blobs along the rim
	local rimGlow = newEmitter(rimHolder, {
		Texture = GLOW_TEX,
		Color = cseq(0, WHITE, 0.3, GREEN_LIGHT, 1, GREEN_DARK),
		LightEmission = 1,
		Size = seq(0, 0.8 * k, 1, 2.6 * k),
		Transparency = seq(0, 1, 0.15, 0.5, 1, 1),
		Lifetime = NumberRange.new(0.5, 0.9),
		Speed = NumberRange.new(0.5, 2.5),
		SpreadAngle = Vector2.new(60, 60),
		EmissionDirection = Enum.NormalId.Top,
		Rotation = NumberRange.new(0, 360),
		RotSpeed = NumberRange.new(-60, 60),
	})

	-- glints getting pulled into the portal
	local suck = newEmitter(suckHolder, {
		Texture = SPARK_TEX,
		Color = ColorSequence.new(WHITE, GREEN_LIGHT),
		LightEmission = 1,
		Size = seq(0, 0.45, 0.8, 0.3, 1, 0),
		Transparency = seq(0, 1, 0.15, 0, 0.8, 0.2, 1, 1),
		Lifetime = NumberRange.new(0.35, 0.55),
		Speed = NumberRange.new(8, 14),
		SpreadAngle = Vector2.new(8, 8),
		EmissionDirection = Enum.NormalId.Bottom,
		Rotation = NumberRange.new(0, 360),
	})

	-- bright mist drifting out of the portal face
	local mist = newEmitter(faceHolder, {
		Texture = SMOKE_TEX,
		Color = cseq(0, GREEN_LIGHT, 0.5, CONFIG.GREEN, 1, GREEN_DARK),
		LightEmission = 0.55,
		Size = seq(0, 1.8 * k, 1, 5 * k),
		Transparency = seq(0, 1, 0.2, 0.62, 1, 1),
		Lifetime = NumberRange.new(1.0, 1.6),
		Speed = NumberRange.new(0.8, 2.5),
		SpreadAngle = Vector2.new(25, 25),
		EmissionDirection = Enum.NormalId.Front,
		Rotation = NumberRange.new(0, 360),
		RotSpeed = NumberRange.new(-60, 60),
	})

	-- dark green wisps for depth (no glow, so they read as shadowy smoke)
	local dark = newEmitter(faceHolder, {
		Texture = SMOKE_TEX,
		Color = cseq(0, GREEN_DARK, 1, Color3.fromRGB(4, 40, 18)),
		LightEmission = 0,
		Size = seq(0, 2 * k, 1, 6 * k),
		Transparency = seq(0, 1, 0.25, 0.55, 1, 1),
		Lifetime = NumberRange.new(1.2, 1.9),
		Speed = NumberRange.new(0.5, 2),
		SpreadAngle = Vector2.new(30, 30),
		EmissionDirection = Enum.NormalId.Front,
		Rotation = NumberRange.new(0, 360),
		RotSpeed = NumberRange.new(-40, 40),
	})

	-- tiny glowing white motes floating off the face
	local motes = newEmitter(faceHolder, {
		Texture = SPARK_TEX,
		Color = ColorSequence.new(WHITE, GREEN_LIGHT),
		LightEmission = 1,
		Size = seq(0, 0.35, 0.5, 0.28, 1, 0),
		Transparency = seq(0, 0, 0.7, 0.25, 1, 1),
		Lifetime = NumberRange.new(0.8, 1.5),
		Speed = NumberRange.new(1, 3.5),
		SpreadAngle = Vector2.new(35, 35),
		EmissionDirection = Enum.NormalId.Front,
		Acceleration = Vector3.new(0, 1.5, 0),
		Rotation = NumberRange.new(0, 360),
	})

	-- Invisible trigger part IN FRONT of the image: this is the real portal
	local trigger
	if cfg.onEnter then
		trigger = newFxPart(Vector3.new(size * 0.7, size * 0.92, 2.4), cf * CFrame.new(0, 0, -1.3))
		trigger.Name = "PortalTrigger"
		trigger.CanTouch = true
		trigger.Parent = model
	end

	local function tryEnter()
		if portal.closed or portal.used or portal.busy or not portal.armed or not cfg.onEnter then
			return
		end
		portal.busy = true
		local ok = cfg.onEnter(portal)
		if ok then
			portal.used = true
			portal.close(CONFIG.CLOSE_DELAY)
		else
			task.delay(1.2, function()
				portal.busy = false
			end)
		end
	end

	if trigger then
		trigger.Touched:Connect(function(hit)
			local char = player.Character
			if char and hit:IsDescendantOf(char) then
				tryEnter()
			end
		end)
	end

	-- Electric filament flicking between two points on the rim
	local function arc()
		local a1 = math.random() * math.pi * 2
		local a2 = a1 + math.rad(rand(70, 160)) * ((math.random() < 0.5) and 1 or -1)
		local function rimPoint(a)
			return pos + (cf.RightVector * math.cos(a) + cf.UpVector * math.sin(a)) * (radius * 0.92) + cf.LookVector * 0.2
		end

		local at0 = Instance.new("Attachment")
		at0.Parent = core
		at0.WorldPosition = rimPoint(a1)
		local at1 = Instance.new("Attachment")
		at1.Parent = core
		at1.WorldPosition = rimPoint(a2)

		local beam = Instance.new("Beam")
		beam.Attachment0 = at0
		beam.Attachment1 = at1
		beam.Color = cseq(0, WHITE, 0.5, GREEN_LIGHT, 1, WHITE)
		beam.LightEmission = 1
		beam.LightInfluence = 0
		beam.FaceCamera = true
		beam.Segments = 14
		beam.Width0 = 0.28
		beam.Width1 = 0.28
		beam.CurveSize0 = rand(-1, 1) * radius * 0.5
		beam.CurveSize1 = rand(-1, 1) * radius * 0.5
		beam.Transparency = NumberSequence.new(0.1)
		beam.Parent = core
		tween(beam, 0.16, { Width0 = 0, Width1 = 0 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		Debris:AddItem(beam, 0.25)
		Debris:AddItem(at0, 0.25)
		Debris:AddItem(at1, 0.25)
	end

	-- Emission helper: how many particles are due this frame
	local acc = {}
	local function due(name, perSecond, dt)
		local v = (acc[name] or 0) + perSecond * dt
		local n = math.floor(v)
		acc[name] = v - n
		return n
	end

	-- Per-frame animation
	local t0 = os.clock()
	local last = t0
	local nextRing = 0
	local nextArc = 0
	local ringIndex = 0
	local conn
	conn = RunService.Heartbeat:Connect(function()
		if not core.Parent then
			conn:Disconnect()
			return
		end
		local now = os.clock()
		local dt = math.min(now - last, 0.1)
		last = now
		local t = now - t0
		local s = scaleValue.Value
		local sPos = math.max(s, 0)
		local sClamp = math.min(sPos, 1)

		-- the swirl whirls extra fast while opening and closing
		local boost = 1
		if portal.openedAt then
			boost += 3.2 * math.exp(-(now - portal.openedAt) * 4.5)
		end
		if portal.closeAt then
			boost += 5 * math.clamp((now - portal.closeAt) / 0.35, 0, 1)
		end

		-- image layers
		local pulse = 0.93 + 0.05 * math.sin(t * 6.2) + 0.02 * math.sin(t * 13.1)
		local px = s * pulse
		for _, layer in ipairs(layers) do
			layer.rot = (layer.rot + dt * CONFIG.SPIN_SPEED * layer.def.spin * boost) % 360
			local lp = math.max(px * layer.def.scale, 0)
			for _, img in ipairs(layer.imgs) do
				img.Size = UDim2.fromScale(lp, lp)
				img.Rotation = layer.rot
			end
		end

		-- rim
		for _, rr in ipairs(rimRings) do
			local fs = rr.def.frac * sPos
			rr.frame.Size = UDim2.fromScale(fs, fs)
			rr.stroke.Thickness = rr.def.thick * sClamp * (0.85 + 0.15 * math.sin(t * 8 + rr.phase))
			rr.stroke.Transparency = math.clamp(rr.def.tr + 0.1 * math.sin(t * 6 + rr.phase), 0, 1)
			rr.gradient.Rotation = (t * rr.def.gspeed) % 360
		end

		-- glow disc + light (dark green <-> bright green)
		local wave = 0.5 + 0.5 * math.sin(t * 3.4)
		local glowSize = math.max(size * 0.95 * px, 0.05)
		glow.Size = Vector3.new(0.04, glowSize, glowSize)
		glow.Color = GREEN_DARK:Lerp(CONFIG.GREEN, wave)
		glow.Transparency = 0.78 + 0.1 * math.sin(t * 7)
		light.Brightness = 4 * sPos * (0.85 + 0.15 * math.sin(t * 9))
		light.Color = CONFIG.GREEN:Lerp(GREEN_LIGHT, wave * 0.6)

		-- orbiting ribbons
		local showTrails = portal.emitting and sPos > 0.2
		for _, o in ipairs(orbiters) do
			o.ang += dt * o.speed * (0.6 + 0.4 * boost)
			local r = radius * o.r * sPos * (1 + 0.05 * math.sin(t * 7 + o.phase))
			o.part.CFrame = CFrame.new(
				pos
					+ cf.RightVector * (math.cos(o.ang) * r)
					+ cf.UpVector * (math.sin(o.ang) * r)
					+ cf.LookVector * 0.15
			)
			o.trail.Enabled = showTrails
		end

		-- particles + ring pulses + arcs
		if portal.emitting and sClamp > 0.15 then
			-- rim sparks / glow blobs (one random spot on the rim per frame)
			local nSp = due("sp", 70 * sClamp, dt)
			local nGl = due("gl", 24 * sClamp, dt)
			if nSp + nGl > 0 then
				local ang = math.random() * math.pi * 2
				local c, sn = math.cos(ang), math.sin(ang)
				local out = cf.RightVector * c + cf.UpVector * sn
				local tangent = cf.RightVector * -sn + cf.UpVector * c
				rimHolder.CFrame = CFrame.fromMatrix(pos + out * (radius * 0.95 * sPos), tangent, out)
				if nSp > 0 then rimSparks:Emit(nSp) end
				if nGl > 0 then rimGlow:Emit(nGl) end
			end

			-- glints sucked in from outside the rim
			local nSu = due("su", 32 * sClamp, dt)
			if nSu > 0 then
				local ang = math.random() * math.pi * 2
				local c, sn = math.cos(ang), math.sin(ang)
				local out = cf.RightVector * c + cf.UpVector * sn
				local tangent = cf.RightVector * -sn + cf.UpVector * c
				suckHolder.CFrame = CFrame.fromMatrix(pos + out * (radius * rand(1.2, 1.5)), tangent, out)
				suck:Emit(nSu)
			end

			-- mist / dark wisps / motes from a random spot on the face
			local nMi = due("mi", 18 * sClamp, dt)
			local nDa = due("da", 9 * sClamp, dt)
			local nMo = due("mo", 22 * sClamp, dt)
			if nMi + nDa + nMo > 0 then
				local ang = math.random() * math.pi * 2
				local rr = radius * 0.85 * math.sqrt(math.random())
				faceHolder.CFrame = cf * CFrame.new(math.cos(ang) * rr, math.sin(ang) * rr, -0.1)
				if nMi > 0 then mist:Emit(nMi) end
				if nDa > 0 then dark:Emit(nDa) end
				if nMo > 0 then motes:Emit(nMo) end
			end
		end

		if portal.open and not portal.closed then
			if t >= nextRing then
				nextRing = t + 0.45
				ringIndex += 1
				ringEffect(
					cf * CFrame.new(0, 0, -0.16),
					size * 1.35,
					(ringIndex % 2 == 0) and WHITE or GREEN_LIGHT,
					0.9, 0.55, 5
				)
			end
			if t >= nextArc then
				nextArc = t + rand(0.1, 0.3)
				arc()
			end
		end

		-- trigger polling fallback
		if trigger and portal.armed and not portal.used and not portal.closed then
			local root = getRoot(player)
			if root then
				local rel = trigger.CFrame:PointToObjectSpace(root.Position)
				local half = trigger.Size / 2
				if math.abs(rel.X) <= half.X and math.abs(rel.Y) <= half.Y and math.abs(rel.Z) <= half.Z then
					tryEnter()
				end
			end
		end
	end)

	local function doClose()
		if portal.closed then return end
		portal.closed = true
		portal.open = false
		portal.armed = false
		portal.emitting = false
		portal.closeAt = os.clock()
		activePortals[portal] = nil
		playSoundAt(CONFIG.SOUND_PORTAL, pos, 0.8, 0.9)

		-- implosion: collapsing ring + sparks sucked into the centre
		ringEffect(cf * CFrame.new(0, 0, -0.1), size * 1.3, WHITE, 0.35, 0.86, 8, 0.1, Enum.EasingDirection.In)
		rimBurst(cf, radius * 1.2, true, 3)
		tween(scaleValue, 0.34, { Value = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)

		task.delay(2.2, function()
			conn:Disconnect()
			model:Destroy()
		end)
	end

	function portal.close(delay)
		if portal.closed then return end
		if delay and delay > 0 then
			if portal.closing then return end
			portal.closing = true
			task.delay(delay, doClose)
		else
			doClose()
		end
	end

	-- Opening sequence: glowing ball -> flash -> portal whirls open
	task.spawn(function()
		local ball = newFxPart(Vector3.one * 1.0, CFrame.new(cfg.origin or pos))
		ball.Shape = Enum.PartType.Ball
		ball.Material = Enum.Material.Neon
		ball.Color = Color3.fromRGB(230, 255, 235)
		ball.Transparency = 0
		ball.Parent = fx

		local aura = newFxPart(Vector3.one * 2.0, ball.CFrame)
		aura.Shape = Enum.PartType.Ball
		aura.Material = Enum.Material.Neon
		aura.Color = CONFIG.GREEN
		aura.Transparency = 0.7
		aura.Parent = fx

		local ballLight = Instance.new("PointLight")
		ballLight.Color = CONFIG.GREEN
		ballLight.Range = 16
		ballLight.Brightness = 4
		ballLight.Parent = ball

		local ballTrail = makeTrail(ball, GREEN_LIGHT, 0.22, 0.8, 1)

		local ballSparks = newEmitter(ball, {
			Texture = SPARK_TEX,
			Color = ColorSequence.new(WHITE, CONFIG.GREEN),
			LightEmission = 1,
			Size = seq(0, 0.6, 1, 0),
			Transparency = seq(0, 0, 1, 1),
			Lifetime = NumberRange.new(0.3, 0.5),
			Speed = NumberRange.new(0, 2),
			SpreadAngle = Vector2.new(180, 180),
			Rotation = NumberRange.new(0, 360),
			Rate = 90,
		})

		if cfg.origin then
			local flight = tween(ball, 0.14, { Position = pos }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
			tween(aura, 0.14, { Position = pos }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
			flight.Completed:Wait()
		else
			ball.Size = Vector3.one * 0.2
			aura.Size = Vector3.one * 0.4
			tween(aura, 0.1, { Size = Vector3.one * 2.0 }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
			local grow = tween(ball, 0.1, { Size = Vector3.one * 1.0 }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
			grow.Completed:Wait()
		end

		if portal.closed then
			ball:Destroy()
			aura:Destroy()
			return
		end

		ballTrail.Enabled = false
		ballSparks.Enabled = false
		portal.emitting = true
		portal.openedAt = os.clock()
		playSoundAt(CONFIG.SOUND_PORTAL, pos, 1)

		-- opening flourish
		local front = cf * CFrame.new(0, 0, -0.12)
		discFlash(cf * CFrame.new(0, 0, -0.24), size * 1.6, WHITE, 0.4, 0.05)
		discFlash(cf * CFrame.new(0, 0, -0.3), size * 2.0, CONFIG.GREEN, 0.6, 0.45)
		ringEffect(front, size * 1.9, WHITE, 0.5, 0.2, 12)
		ringEffect(front, size * 1.5, GREEN_LIGHT, 0.7, 0.1, 9)
		rimBurst(cf, radius * 0.95, false, 4)

		tween(ballLight, 0.5, { Brightness = 0 })
		tween(ball, 0.38, { Size = Vector3.one * size * 0.8, Transparency = 1 }, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
		tween(aura, 0.5, { Size = Vector3.one * size * 1.25, Transparency = 1 }, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
		tween(scaleValue, 0.42, { Value = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
		Debris:AddItem(ball, 0.7)
		Debris:AddItem(aura, 0.7)

		task.wait(0.42)
		if portal.closed then return end
		portal.open = true

		task.wait(0.25)
		if portal.closed then return end
		portal.armed = true
	end)

	return portal
end


------------------------------------------------------------------------
-- ABILITIES
